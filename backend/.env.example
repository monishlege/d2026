# ============================================
# JanRakshak AI Backend - Environment Variables
# ============================================
# 
# Copy this file to `.env.local` or `.env` and fill in the values.
# NEVER commit the `.env` file with actual keys to version control.
#

# ============================================
# BHASHINI / AI4BHARAT API Configuration
# ============================================
# 
# Enables live multilingual support for:
# - Speech-to-Text (STT) in regional languages
# - Text-to-Speech (TTS) synthesis
# - Machine Translation (NMT) between Indian languages
#
# Get your API credentials from: https://bhashini.gov.in/
#

# Bhashini API Key (required for live speech services)
BHASHINI_API_KEY=your_bhashini_api_key_here

# Bhashini API Endpoint (default: official endpoint)
# BHASHINI_API_URL=https://api.bhashini.gov.in/services/inference
BHASHINI_API_URL=https://api.bhashini.gov.in/services/inference

# Your User ID for Bhashini API tracking
BHASHINI_USER_ID=your_user_id_here

# ULCA API Key (for ULCA-integrated Bhashini services)
# BHASHINI_ULCA_API_KEY=your_ulca_api_key_here

# ============================================
# QDRANT VECTOR DATABASE Configuration
# ============================================
#
# Enables RAG (Retrieval-Augmented Generation) for:
# - Semantic search over government scheme documents
# - Eligibility rule retrieval
# - Knowledge base QA
#
# Get your Qdrant instance from:
# - Managed: https://qdrant.to/cloud
# - Self-hosted: https://qdrant.tech/documentation/
#

# Qdrant API URL (e.g., https://your-instance.qdrant.io:6333)
# For local development: http://localhost:6333
QDRANT_URL=http://localhost:6333

# Qdrant API Key (required for managed/authenticated instances)
# Leave empty for local development without authentication
QDRANT_API_KEY=your_qdrant_api_key_here

# Qdrant Collection Name (stores scheme documents and embeddings)
QDRANT_COLLECTION_NAME=government_schemes

# ============================================
# Authentication Configuration
# ============================================

# Basic auth credentials (for officer login)
# These can also be overridden by environment variables
JANRAKSHAK_USERNAME=desih26
JANRAKSHAK_PASSWORD=Win@2026SIH!

# ============================================
# Server Configuration
# ============================================

# Application environment (development | staging | production)
ENVIRONMENT=development

# Enable debug mode (true | false)
DEBUG=true

# Frontend URL for CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173

# ============================================
# Setup Instructions
# ============================================
#
# 1. BHASHINI SETUP:
#    - Visit https://bhashini.gov.in/
#    - Create an account and request API access
#    - Copy your API key and User ID here
#    - Note: Free tier includes limited requests per month
#
# 2. QDRANT SETUP:
#    Option A - Cloud (Recommended for production):
#      - Visit https://qdrant.to/cloud
#      - Create a cluster
#      - Copy the URL and API key
#    
#    Option B - Docker (For local development):
#      docker run -p 6333:6333 \
#        -e QDRANT__API_KEY=your_optional_key \
#        qdrant/qdrant:latest
#    
#    Option C - Kubernetes:
#      See https://qdrant.tech/documentation/deployment/
#
# 3. LOCAL DEVELOPMENT:
#    - Create `.env.local` file (copy this file)
#    - Remove/comment out external API keys
#    - Use mock mode for development
#
# ============================================
# Fallback Behavior (when keys are missing)
# ============================================
#
# - BHASHINI_API_KEY missing:
#   → Speech services use mock transcription
#   → Translations use identity (returns input text)
#   → TTS uses mock/placeholder audio
#
# - QDRANT not configured:
#   → RAG returns mock scheme results
#   → Semantic search returns predefined examples
#   → RAG features fully unavailable
#
# Errors are logged but application continues running.
#
